PORT=3001
JWT_SECRET=hotcopy_jwt_secret_random_token_98765
ADMIN_KEY=hotcopy_super_admin_pass_8888

# ========================================================
# 1. 语音听写引擎（Groq Whisper-large-v3，每日免费 2000 次）
# ========================================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ========================================================
# 2. 文本创作大脑（支持无缝切换 Groq / DeepSeek / OpenAI）
# ========================================================

# --- 【方案一：Groq 免费极速模型（默认零成本，每秒数百字）】---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=gsk_your_groq_api_key_here

# --- 【方案二：DeepSeek-V3（国产顶级中文网感，1元/百万Token）】---
# 如需启用：将上面方案一注释掉，取消下面三行的注释并填入 sk- Key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-api-key

# --- 【方案三：OpenAI 官方通用方案】---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-api-key

# ========================================================
# 3. 商业支付配置（Creem.io Webhook）
# ========================================================
CREEM_WEBHOOK_SECRET=your_creem_webhook_signing_secret
