# Core service. Copy into a private .env file; never commit real credentials.
PORT=3001
# Set both before public deployment. Empty JWT_SECRET uses an ephemeral key.
JWT_SECRET=
ADMIN_KEY=

# OpenAI-compatible text provider, for example Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# YouTube yt-dlp binary and optional ISP/cookie egress configuration.
YTDLP_BIN=yt-dlp
# Three independent account cookies. Use private files with mode 0600.
YTDLP_COOKIES_PATH=/opt/hotcopy/cookies.txt
YTDLP_COOKIES_BACKUP_1_PATH=/opt/hotcopy/cookies-backup-1.txt
YTDLP_COOKIES_BACKUP_2_PATH=/opt/hotcopy/cookies-backup-2.txt
# YTDLP_EGRESS_CONFIG=/private/path/to/youtube-egress.json

# Alternative OpenAI-compatible text providers may use their own base URL,
# model ID and key. Keep those three values matched to one provider.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# Existing checkout/webhook support, configured only when payment work resumes.
CREEM_WEBHOOK_SECRET=

# Keep old member rights until price and billing policy are finalized.
HOTCOPY_ENABLE_UNIT_BILLING=0
HOTCOPY_MAX_RUNNING=2
HOTCOPY_LOCAL_CONCURRENCY=1
